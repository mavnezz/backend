# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Datenbank
# Dev: better-sqlite3 (Zero-Config)  |  Prod: postgres
DB_TYPE=better-sqlite3
DB_DATABASE=dev.sqlite
# Nur für Postgres relevant:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=change-me-please-in-production
JWT_EXPIRES_IN=3600s

# Initialer Admin (optional): wird beim Boot automatisch angelegt, wenn gesetzt.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
